# =============================================================================
# tunnel-service (control plane) — пример конфигурации.
# Скопируйте в .env и заполните. .env в .gitignore, настоящие значения
# в репозиторий не коммитим никогда. В бою переменные приходят из Dokploy.
# =============================================================================

# --- Процесс ---------------------------------------------------------------

# development | test | production.
NODE_ENV=development

# Адрес и порт HTTP-слушателя.
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Доверять ли X-Forwarded-For при определении адреса клиента. За Dokploy/Traefik
# нужно true, иначе лимит по IP посчитает всех за один адрес. Если сервис
# когда-нибудь будет смотреть в интернет напрямую — false, иначе заголовок
# подделают и лимит обойдут.
TRUST_PROXY=true

# debug | info | warn | error
LOG_LEVEL=debug

# Сколько ждать завершения текущих запросов при SIGTERM, миллисекунды.
SHUTDOWN_TIMEOUT_MS=15000

# --- База данных -----------------------------------------------------------

# Строка подключения к PostgreSQL. Локально поднимается docker-compose.
DATABASE_URL=postgres://tunnel:tunnel@localhost:5432/tunnel

# Максимум соединений в пуле.
DATABASE_POOL_MAX=10

# true — включить TLS к базе (managed postgres). Локально false.
DATABASE_SSL=false

# --- Публичные адреса ------------------------------------------------------

# Домен, к которому приклеивается слаг: ivan -> ivan.play.ttg.club
PUBLIC_DOMAIN=play.ttg.club

# --- Подпись тикетов -------------------------------------------------------

# EdDSA (Ed25519) или ES256. По умолчанию EdDSA.
TICKET_ALG=EdDSA

# Время жизни тикета в секундах. 900 = 15 минут.
TICKET_TTL_SECONDS=900

# Значения claim'ов iss/aud в тикете. Нода должна проверять их у себя.
TICKET_ISSUER=tunnel.ttg.club
TICKET_AUDIENCE=ttg-tunnel-node

# Приватный ключ подписи: PKCS#8 PEM, закодированный в base64 (одной строкой,
# чтобы не мучиться с переносами в Dokploy). Сгенерировать: npm run keygen
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
TICKET_PRIVATE_KEY_CURRENT=

# Предыдущий ключ. Задаётся на время ротации: подпись идёт новым ключом,
# а JWKS отдаёт оба, чтобы уже выданные тикеты и живые туннели не порвались.
# Убирать не раньше, чем через TICKET_TTL_SECONDS после ротации.
TICKET_PRIVATE_KEY_PREVIOUS=

# Значение claim tier в тикете. Тарифов у subscriber не существует — ни поля,
# ни понятия, — поэтому это просто константа. Должна быть именем из таблицы
# TIERS в src/domain/limits.ts, иначе сервис не стартует.
TICKET_TIER=pro

# --- Проверка JWT пользователя (auth.api.ttg.club) -------------------------

# Тот же JWT_SECRET, что у остальных сервисов TTG. auth-сервис подписывает
# токены симметричным ключом (HS256), публичных ключей у него нет, поэтому
# подпись проверяется локально этим же секретом. Минимум 32 байта.
# ОБЯЗАТЕЛЕН (либо AUTH_JWKS_URL): без него сервис не стартует. Режима
# «декодировать токен без проверки подписи» не существует.
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
AUTH_JWT_SECRET=

# Запасной путь на будущее: когда auth переедет на асимметричную подпись,
# сюда кладётся URL его JWKS, и переключение обходится без правки кода.
# Заданы обе переменные — работает JWKS, в лог пишется предупреждение.
# Ожидается: https://auth.api.ttg.club/.well-known/jwks.json
AUTH_JWKS_URL=

# Сколько кэшировать JWKS auth-сервиса, секунды. Без AUTH_JWKS_URL не работает.
AUTH_JWKS_CACHE_SECONDS=3600

# Допуск на расхождение часов при проверке exp, секунды.
AUTH_CLOCK_TOLERANCE_SECONDS=30

# iss, aud, nbf и jti auth-сервис не выдаёт — мы их не проверяем и не требуем.
# Имя пользователя берётся строго из claim username.

# --- Подписка (subscriber.api.ttg.club) ------------------------------------

SUBSCRIBER_BASE_URL=https://subscriber.api.ttg.club

# Service-to-service ручка статуса. Ключ — username из токена (НЕ account_id),
# подставляется в {username} и обязательно URL-энкодится.
SUBSCRIBER_STATUS_PATH=/api/internal/subscriptions/{username}/status

# Секрет для заголовка X-Service-Token этой ручки. Тот же INTERNAL_SERVICE_SECRET,
# что у subscriber-сервиса. Обязателен: без него ручка отвечает 401.
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
INTERNAL_SERVICE_SECRET=

SUBSCRIBER_TIMEOUT_MS=3000

# Сколько ответ подписки считается свежим, секунды (2–5 минут).
#
# ВАЖНО: событий и вебхуков у subscriber нет, об отзыве подписки мы узнаём
# только опросом. Поэтому это же значение — окно, в течение которого отозванный
# пользователь ещё может получить тикет. Подробности в README.
SUBSCRIPTION_CACHE_TTL_SECONDS=180

# Сколько максимум разрешено отдавать протухший кэш, если сервис подписок
# недоступен. По истечении — отказ.
SUBSCRIPTION_STALE_MAX_SECONDS=86400

# --- Служебный доступ для нод ----------------------------------------------

# Общий секрет для /api/internal/*. Не пользовательский JWT.
# Минимум 32 символа. Сгенерировать: npm run gen:secret
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
NODE_SHARED_SECRET=

# Через сколько секунд без heartbeat нода считается мёртвой и не выдаётся.
NODE_HEARTBEAT_TIMEOUT_SECONDS=90

# --- Слаги -----------------------------------------------------------------

# Файл стоп-листа по мату. Путь относительный — от корня проекта.
SLUG_STOPLIST_PATH=data/stoplist.txt

# Соль для суффиксов слагов миров. ОБЯЗАТЕЛЬНА: без неё сервис не стартует.
# Сгенерировать: npm run gen:salt
#
# МЕНЯТЬ НЕЛЬЗЯ. Уже выданные слаги лежат в таблице slugs и от соли не зависят,
# но новые миры при другой соли получат другие суффиксы. Потеря соли не ломает
# существующие адреса, однако воспроизвести прежнюю схему уже не выйдет.
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
SLUG_SALT=

# --- Лимит запросов тикета -------------------------------------------------

# Защита от того, чтобы через нас нагрузили subscriber.api.
# Сколько запросов POST /api/tunnel/ticket разрешено в окне: на аккаунт и на IP.
TICKET_RATE_LIMIT_PER_ACCOUNT=20
TICKET_RATE_LIMIT_PER_IP=60
TICKET_RATE_LIMIT_WINDOW_SECONDS=60

# --- Сигналы о злоупотреблении ---------------------------------------------

# Квота в 10 ТБ обычной игрой недостижима: она нужна как сигнал, а не как
# ограничитель. Ничего не блокируется автоматически — только пишется в лог.

# С какого процента израсходованной квоты писать warning.
QUOTA_WARN_PERCENT=80

# Прирост трафика за сутки, после которого расход помечается подозрительным, ГБ.
QUOTA_SPIKE_GB_PER_DAY=100
