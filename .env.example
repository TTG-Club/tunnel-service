# =============================================================================
# tunnel-service (control plane) — пример конфигурации.
# Скопируйте в .env и заполните. .env в .gitignore, настоящие значения
# в репозиторий не коммитим никогда. В бою переменные приходят из Dokploy.
# =============================================================================

# --- Процесс ---------------------------------------------------------------

# development | test | production. В production сервис откажется стартовать
# без AUTH_JWKS_URL (см. ниже) — это защита от выдачи тикетов без проверки JWT.
NODE_ENV=development

# Адрес и порт HTTP-слушателя.
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# debug | info | warn | error
LOG_LEVEL=debug

# Сколько ждать завершения текущих запросов при SIGTERM, миллисекунды.
SHUTDOWN_TIMEOUT_MS=15000

# --- База данных -----------------------------------------------------------

# Строка подключения к PostgreSQL. Локально поднимается docker-compose.
DATABASE_URL=postgres://tunnel:tunnel@localhost:5432/tunnel

# Максимум соединений в пуле.
DATABASE_POOL_MAX=10

# true — включить TLS к базе (managed postgres). Локально false.
DATABASE_SSL=false

# --- Публичные адреса ------------------------------------------------------

# Домен, к которому приклеивается слаг: ivan -> ivan.play.ttg.club
PUBLIC_DOMAIN=play.ttg.club

# --- Подпись тикетов -------------------------------------------------------

# EdDSA (Ed25519) или ES256. По умолчанию EdDSA.
TICKET_ALG=EdDSA

# Время жизни тикета в секундах. 900 = 15 минут.
TICKET_TTL_SECONDS=900

# Значения claim'ов iss/aud в тикете. Нода должна проверять их у себя.
TICKET_ISSUER=tunnel.ttg.club
TICKET_AUDIENCE=ttg-tunnel-node

# Приватный ключ подписи: PKCS#8 PEM, закодированный в base64 (одной строкой,
# чтобы не мучиться с переносами в Dokploy). Сгенерировать: npm run keygen
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
TICKET_PRIVATE_KEY_CURRENT=

# Предыдущий ключ. Задаётся на время ротации: подпись идёт новым ключом,
# а JWKS отдаёт оба, чтобы уже выданные тикеты и живые туннели не порвались.
# Убирать не раньше, чем через TICKET_TTL_SECONDS после ротации.
TICKET_PRIVATE_KEY_PREVIOUS=

# --- Проверка JWT пользователя (auth.api.ttg.club) -------------------------

# URL JWKS auth-сервиса. Пока эндпоинта нет — оставить ПУСТЫМ.
# Пусто  -> dev-режим: токен только декодируется, подпись НЕ проверяется,
#           на каждый запрос пишется warning, старт при NODE_ENV=production
#           запрещён.
# Задано -> полноценная проверка подписи, невалидный токен отклоняется.
# Ожидается: https://auth.api.ttg.club/.well-known/jwks.json
AUTH_JWKS_URL=

# Ожидаемые iss/aud в токене пользователя. Пусто — не проверять.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Сколько кэшировать JWKS auth-сервиса, секунды.
AUTH_JWKS_CACHE_SECONDS=3600

# Из каких claim'ов брать имя аккаунта для генерации слага, по порядку.
AUTH_NAME_CLAIMS=name,username,preferred_username,nickname,login

# --- Подписка (subscriber.api.ttg.club) ------------------------------------

SUBSCRIBER_BASE_URL=https://subscriber.api.ttg.club
SUBSCRIBER_STATUS_PATH=/api/subscriptions/status
SUBSCRIBER_TIMEOUT_MS=3000

# Сколько ответ подписки считается свежим, секунды (2–5 минут).
SUBSCRIPTION_CACHE_TTL_SECONDS=180

# Сколько максимум разрешено отдавать протухший кэш, если сервис подписок
# недоступен. По истечении — отказ.
SUBSCRIPTION_STALE_MAX_SECONDS=86400

# Тариф по умолчанию, пока subscriber.api не отдаёт поле tier.
SUBSCRIPTION_DEFAULT_TIER=pro

# --- Служебный доступ для нод ----------------------------------------------

# Общий секрет для /api/internal/*. Не пользовательский JWT.
# Минимум 32 символа. Сгенерировать: npm run gen:secret
# ЗАПОЛНЯЕТСЯ ТОЛЬКО В .env И В DOKPLOY. Здесь всегда пусто.
NODE_SHARED_SECRET=

# Через сколько секунд без heartbeat нода считается мёртвой и не выдаётся.
NODE_HEARTBEAT_TIMEOUT_SECONDS=90
