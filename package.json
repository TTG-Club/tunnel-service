{
  "name": "@ttg/tunnel-service",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane сервиса туннелей TTG: слаги, тикеты, лимиты",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts up",
    "migrate:status": "tsx src/cli/migrate.ts status",
    "keygen": "tsx src/cli/keygen.ts",
    "gen:secret": "tsx src/cli/gen-secret.ts",
    "gen:salt": "tsx src/cli/gen-salt.ts",
    "devtoken": "tsx src/cli/devtoken.ts",
    "mock:subscriber": "node tools/subscriber-mock.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "h3": "^1.15.11",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
